# Entorno de ejecución: development | test | production
NODE_ENV=development

# Puerto HTTP
PORT=3000

# Ruta del archivo SQLite (o ':memory:' en tests)
DATABASE_URL=./data/todo.sqlite

# Aplica las migraciones pendientes al arrancar la aplicación.
# En producción con una sola instancia puede dejarse en true; con varias
# instancias, ponerlo en false y ejecutar `npm run db:migration:run` en el release.
DB_AUTO_MIGRATE=true

# Origen permitido para CORS: '*' o una lista separada por comas
CORS_ORIGIN=*
