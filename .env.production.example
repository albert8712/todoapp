# Plantilla de entorno para producción. No commitear el archivo real:
#   sudo install -m 600 .env.production.example /etc/todoapp/todoapp.env

NODE_ENV=production
PORT=3000

# Directorio escribible por el usuario `todoapp` (ReadWritePaths del unit).
DATABASE_URL=/var/lib/todoapp/todo.sqlite

# Las migraciones se ejecutan como paso de release:
#   npm run db:migration:run
DB_AUTO_MIGRATE=false

# Dominio real del frontend, nunca '*' en producción.
CORS_ORIGIN=https://app.example.com
