# TypeORM 1.x declara `better-sqlite3` ^12 como peer opcional, pero la v12 no
# publica binarios precompilados y en Windows/Node 26 exigiría compilar con
# Visual Studio Build Tools. La v13 es compatible a nivel de API y sí incluye
# binarios N-API para todas las plataformas, así que se acepta el desajuste.
legacy-peer-deps=true
